{
  "title": "Radio Garden",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "Browse and stream",
        "live radio stations",
        "worldwide via",
        "Radio Garden.",
        "",
        "Navigate by continent",
        "country, and city to",
        "find stations.",
        "",
        "Requires internet",
        "connection."
      ]
    },
    {
      "title": "Controls",
      "children": [
        {
          "title": "Navigation",
          "lines": [
            "Page 1, Browse:",
            "Click to enter the",
            "station browser.",
            "Jog: scroll list",
            "Jog Click: select",
            "Back: up one level,",
            "then out to pages.",
            "",
            "Browse hierarchy:",
            " Continent",
            "  > Country",
            "   > City",
            "    > Station",
            "",
            "[Random], first on",
            "the list, picks a",
            "random city and",
            "plays a random",
            "station from it.",
            "",
            "~970 cities indexed.",
            "Stations fetched",
            "live from Radio",
            "Garden API."
          ]
        },
        {
          "title": "Playback",
          "lines": [
            "Page 2, Controls:",
            "Knob 1: Gain",
            " (0-2x output)",
            "Knob 2: Play/Pause",
            "Knob 3: Stop",
            " Click to fire.",
            "",
            "The bottom line of",
            "the Browse page",
            "shows what is",
            "playing."
          ]
        }
      ]
    },
    {
      "title": "Tips",
      "lines": [
        "Navigation state is",
        "saved between loads.",
        "",
        "Station list is",
        "cached for quick",
        "re-entry.",
        "",
        "Streams use MP3",
        "via ffmpeg with a",
        "30-second buffer",
        "to prevent dropouts."
      ]
    }
  ]
}
